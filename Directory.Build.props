<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Conroy</Authors>
    <Company>Achievement Relay</Company>
    <Product>Achievement Relay</Product>
    <Copyright>Copyright © 2026 Achievement Relay contributors</Copyright>
    <RepositoryUrl>https://github.com/Conroy1988/Achievement-Relay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
