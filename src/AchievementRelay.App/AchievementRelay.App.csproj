<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\AchievementRelay.ico</ApplicationIcon>
    <AssemblyName>AchievementRelay.App</AssemblyName>
    <RootNamespace>AchievementRelay.App</RootNamespace>
    <Version>0.5.0</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <Description>Automatically relay new Xbox and Steam achievements to Discord.</Description>
    <UpdatePublisherCertificateSha256 Condition="'$(UpdatePublisherCertificateSha256)' == ''"></UpdatePublisherCertificateSha256>
    <AchievementRelayPackageVersion Condition="'$(AchievementRelayPackageVersion)' == ''">$(FileVersion)</AchievementRelayPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AchievementRelay.UpdatePublisherCertificateSha256</_Parameter1>
      <_Parameter2>$(UpdatePublisherCertificateSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AchievementRelay.PackageVersion</_Parameter1>
      <_Parameter2>$(AchievementRelayPackageVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementRelay.Core\AchievementRelay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\Facepunch.Steamworks.LICENSE.txt" Link="third_party\Facepunch.Steamworks.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AchievementRelay.ico" />
    <Resource Include="Assets\AchievementRelay.png" />
    <Resource Include="Assets\RelayCommandDeck.png" />
    <Resource Include="Assets\TrophyCup.png" />
    <Resource Include="Assets\RadarSweep.png" />
    <Resource Include="Assets\Xbox.png" />
    <Resource Include="Assets\Steam.png" />
    <Resource Include="Assets\Discord.png" />
  </ItemGroup>
</Project>
