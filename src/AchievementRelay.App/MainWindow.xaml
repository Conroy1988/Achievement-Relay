<Window x:Class="AchievementRelay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Relay"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0C121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="6,8,0,28">
          <Image Source="Assets/AchievementRelay.png" Width="42" Height="42" Stretch="Uniform" />
          <StackPanel Margin="10,1,0,0">
            <TextBlock Text="ACHIEVEMENT" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="RELAY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button Style="{StaticResource NavButton}" Click="ShowDashboard_Click" Content="⌂   Dashboard" />
          <Button Style="{StaticResource NavButton}" Click="ShowSetup_Click" Content="✓   Guided setup" />
          <Button Style="{StaticResource NavButton}" Click="ShowActivity_Click" Content="↯   Activity" />
          <Button Style="{StaticResource NavButton}" Click="ShowSettings_Click" Content="⚙   Settings" />
          <Button Style="{StaticResource NavButton}" Click="ShowDiagnostics_Click" Content="◉   Diagnostics" />
          <Button Style="{StaticResource NavButton}" Click="ShowAbout_Click" Content="ⓘ   About" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="MONITOR STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
            <TextBlock x:Name="SidebarMonitorStatus" Text="Checking…" Margin="0,4,0,0" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </TabControl.Resources>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,36">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Xbox achievement notifications are relayed to your chosen Discord channel in the background." />

            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="WINDOWS ACCESS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="ListenerStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock x:Name="ListenerStatusDetail" Text="Notification listener" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="DISCORD" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="DiscordStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock x:Name="DiscordStatusDetail" Text="Webhook destination" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="RELAY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="RelayStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock Text="System-tray monitoring" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Quick actions" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="Test Discord, review setup or re-scan the current Xbox notifications." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Guided setup" Click="ShowSetup_Click" Margin="0,0,8,0" />
                  <Button Content="Send test" Click="SendSampleAchievement_Click" Margin="0,0,8,0" />
                  <Button Content="Re-scan" Click="Rescan_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10" />
            <ListBox x:Name="DashboardActivityList" Background="Transparent" BorderThickness="0" MaxHeight="270">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,50">
            <TextBlock Style="{StaticResource PageTitle}" Text="Guided setup" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Complete these four steps once. Achievement Relay handles everything automatically afterwards." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDarkBrush}" VerticalAlignment="Top">
                  <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,24,0">
                  <TextBlock Text="Allow notification access" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Windows will ask whether Achievement Relay may read notifications. The app immediately ignores every sender except known Xbox components." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                  <TextBlock x:Name="SetupAccessStatus" Text="Status: not checked" Margin="0,10,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="2" Content="Grant access" Style="{StaticResource PrimaryButton}" Click="GrantNotificationAccess_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDarkBrush}" VerticalAlignment="Top">
                  <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,24,0">
                  <TextBlock Text="Keep Xbox achievement notifications enabled" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="In Windows Notifications, make sure Xbox Game Bar and Xbox are enabled. Focus mode may hide the banner, but the notification must still reach Notification Center." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Open Windows settings" Click="OpenNotificationSettings_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                  <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="Connect a Discord channel" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12">
                    <Run Text="In Discord: " FontWeight="SemiBold" />
                    <Run Text="Server Settings → Integrations → Webhooks → New Webhook → choose a channel → Copy Webhook URL." />
                  </TextBlock>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SetupWebhookPasswordBox" PasswordChar="●" ToolTip="Discord webhook URL" />
                    <Button Grid.Column="1" Content="Official guide" Click="OpenDiscordWebhookGuide_Click" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Save and test" Style="{StaticResource DiscordButton}" Click="SaveAndTestWebhook_Click" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock x:Name="SetupWebhookStatus" Text="Status: not connected" Margin="0,10,0,0" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDarkBrush}" VerticalAlignment="Top">
                  <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="Choose your identity and finish" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Your gamertag or display name is optional. Achievement Relay can configure Windows startup for you." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                  <TextBlock Text="Gamertag / display name" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                  <TextBox x:Name="SetupDisplayNameTextBox" MaxLength="80" Width="360" HorizontalAlignment="Left" />
                  <CheckBox x:Name="SetupStartWithWindowsCheckBox" Content="Start Achievement Relay automatically with Windows" IsChecked="True" />
                  <CheckBox x:Name="SetupStartMinimizedCheckBox" Content="Start quietly in the notification area" IsChecked="True" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Send sample achievement" Click="SendSampleAchievement_Click" Margin="0,0,10,0" />
              <Button Content="Finish setup" Style="{StaticResource PrimaryButton}" Click="FinishSetup_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <Grid Margin="34,30,34,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Local operational history. Webhook URLs and unrelated notification contents are never written here." />
          </StackPanel>
          <ListBox x:Name="ActivityList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Adjust what Achievement Relay posts and how it behaves on Windows." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Discord destination" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsWebhookStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                <TextBlock Text="Paste a new webhook only when replacing the current destination" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <PasswordBox x:Name="SettingsWebhookPasswordBox" PasswordChar="●" />
                <Button Content="Remove saved webhook" Click="RemoveWebhook_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock Text="Webhook display name" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                <TextBox x:Name="SettingsDiscordUsernameTextBox" MaxLength="80" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Achievement posts" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Gamertag / display name" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                <TextBox x:Name="SettingsDisplayNameTextBox" MaxLength="80" />
                <CheckBox x:Name="SettingsRareOnlyCheckBox" Content="Only post rare achievements" />
                <CheckBox x:Name="SettingsRawDetailsCheckBox" Content="Include Xbox description text when available" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Windows behaviour" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="SettingsStartWithWindowsCheckBox" Content="Start automatically with Windows" />
                <CheckBox x:Name="SettingsStartMinimizedCheckBox" Content="Start in the notification area" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Test Discord" Click="TestSettingsWebhook_Click" Margin="0,0,10,0" />
              <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="Diagnostics" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Use these tools if an Xbox achievement appears in Windows but is not relayed." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Live status" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DiagnosticsStatusText" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Capture check" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Unlock an achievement, then return here. Re-scan checks Xbox notifications currently held in Windows Notification Center; already-posted events are safely ignored." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14" />
                <WrapPanel>
                  <Button Content="Re-scan current notifications" Click="Rescan_Click" Margin="0,0,8,8" />
                  <Button Content="Open Windows notifications" Click="OpenNotificationSettings_Click" Margin="0,0,8,8" />
                  <Button Content="Send sample achievement" Click="SendSampleAchievement_Click" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Support tools" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="The copied summary contains status information only—never the Discord webhook token or unrelated notifications." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14" />
                <WrapPanel>
                  <Button Content="Open local data folder" Click="OpenDataFolder_Click" Margin="0,0,8,8" />
                  <Button Content="Copy support summary" Click="CopySupportSummary_Click" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="About Achievement Relay" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Every achievement. Instantly shared." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Image Source="Assets/AchievementRelay.png" Width="96" Height="96" HorizontalAlignment="Left" />
                <TextBlock Text="Achievement Relay" FontSize="25" FontWeight="Bold" Margin="0,14,0,3" />
                <TextBlock x:Name="AboutVersionText" Text="Version 0.1.1 alpha" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                <TextBlock Text="A privacy-first Windows companion that detects Xbox achievement notifications and sends them to a Discord channel chosen by the user." Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" MaxWidth="680" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource KoFiBrush}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock Text="Help Achievement Relay grow" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="If the app makes sharing your unlocks easier, you can support future development on Ko-fi." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="☕  Support on Ko-fi" Style="{StaticResource KoFiButton}" Click="OpenKoFi_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Privacy by design" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Achievement Relay runs locally. It checks the source of each Windows notification first, discards non-Xbox notifications, encrypts the Discord webhook with Windows account protection, and sends only detected achievement information to the configured Discord channel." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,14" />
                <WrapPanel>
                  <Button Content="View privacy policy" Click="OpenPrivacyPolicy_Click" Margin="0,0,8,0" />
                  <Button Content="Open GitHub" Click="OpenGitHub_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
