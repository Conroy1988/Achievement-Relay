<Window x:Class="AchievementRelay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Relay"
        Icon="Assets/AchievementRelay.ico"
        Width="1440"
        Height="920"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="OnWindowSourceInitialized"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Redline.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Border BorderBrush="#BC1630" BorderThickness="1" CornerRadius="8">
  <Grid Background="{StaticResource WindowSurfaceBrush}">
    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="154" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2">
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4"><GradientStop Color="#16090F"/><GradientStop Color="#08090B" Offset="0.5"/><GradientStop Color="#260510" Offset="1"/></LinearGradientBrush></Grid.Background>
      <Path Data="M 0,0 L 65,0 0,65 Z M 20,0 L 82,0 0,82 Z" Fill="#B90022" HorizontalAlignment="Left" Width="82" Stretch="Fill"/>
      <StackPanel Orientation="Horizontal" Margin="55,12,20,12"><Image Source="Assets/AchievementRelay.png" Width="48" Height="48" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ACHIEVEMENT RELAY" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="Bold"/><TextBlock Text="Xbox and Steam achievements, shared with Discord" FontSize="11" Foreground="#B2B8BF"/></StackPanel></StackPanel>
      <TextBlock Text="" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B9A8AF" FontSize="11" Margin="0,0,25,0"/>
    </Grid>
    <Border Grid.Row="1" Grid.Column="0"
            Background="{StaticResource SidebarSurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="7,8,7,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">

          <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonActive}" Click="ShowDashboard_Click" AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" Style="{StaticResource RedlineGlyph}"/>
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ActivityNavButton" Style="{StaticResource NavButton}" Click="ShowActivity_Click" AutomationProperties.Name="Activity history">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A5;" Style="{StaticResource RedlineGlyph}"/>
              <TextBlock Text="Activity" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SetupNavButton" Style="{StaticResource NavButton}" Click="ShowSetup_Click" AutomationProperties.Name="Connections">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" Style="{StaticResource RedlineGlyph}"/>
              <TextBlock Text="Connections" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Click="ShowAccount_Click" AutomationProperties.Name="Relay account and sync"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource RedlineGlyph}"/><TextBlock Text="Account"/></StackPanel></Button>
          <Button x:Name="PresentationNavButton" Style="{StaticResource NavButton}" Click="ShowPresentation_Click" AutomationProperties.Name="Presentation"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource RedlineGlyph}"/><TextBlock Text="Presentation" FontSize="12"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="ShowCompanion_Click" AutomationProperties.Name="Achievement companion"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" Style="{StaticResource RedlineGlyph}"/><TextBlock Text="Companion" FontSize="12"/></StackPanel></Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource RedlineGlyph}"/>
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Click="ShowDiagnostics_Click" AutomationProperties.Name="Help and support">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="?" Width="25" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="Help" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Border Style="{StaticResource SoftCard}" Padding="12" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="RELAY STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock x:Name="SidebarMonitorStatus" Text="Checking…" Margin="0,5,0,0" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource CommunityButton}"
                  Click="OpenCommunityDiscord_Click"
                  Padding="9,7"
                  MinHeight="36"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Join the Achievement Relay community Discord">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Image Source="Assets/Discord.png" Width="15" Height="15" Margin="0,0,7,0" />
              <TextBlock Text="Community Discord" FontSize="11" />
            </StackPanel>
          </Button>
          <Button Content="☕  Support on Ko-fi"
                  Style="{StaticResource KoFiButton}"
                  Click="OpenKoFi_Click"
                  Padding="10,7"
                  MinHeight="36"
                  FontSize="11"
                  AutomationProperties.Name="Support Achievement Relay on Ko-fi" />
          <TextBlock Text="Runs quietly in your tray" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,1" />
        </StackPanel>
      </Grid></ScrollViewer>
    </Border>

    <TabControl x:Name="MainTabs"
                Grid.Row="1" Grid.Column="1"
                Style="{StaticResource ContentTabControl}"
                SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </TabControl.Resources>

      <!-- Redline: the approved B layout. All status and activity are real. -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,8,18,20">
            <Border x:Name="UpdateBanner" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,0,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="4" Background="#33E3AD5E" VerticalAlignment="Top">
                  <TextBlock Text="↓" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,22,0">
                  <TextBlock x:Name="UpdateBannerTitle" Text="Achievement Relay update" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="UpdateBannerMessage" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <ProgressBar x:Name="UpdateBannerProgress" Margin="0,11,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" AutomationProperties.Name="Update download progress" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="UpdateBannerNotesButton" Content="Release notes" Click="OpenUpdateNotes_Click" Margin="0,0,8,0" />
                  <Button x:Name="UpdateBannerActionButton" Content="Update now" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click" />
                </WrapPanel>
              </Grid>
            </Border>



            <Grid x:Name="HomeLayout" SizeChanged="HomeLayout_SizeChanged">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="HomeMainColumn">
                <Border Style="{StaticResource RedlinePanel}" Margin="0,0,0,10">
                  <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock x:Name="HomeTitleText" Text="Ready for your next unlock." FontSize="27" FontWeight="Bold" Margin="0,0,15,6"/>
                      <Border Style="{StaticResource StatusPill}" Margin="0,0,0,6"><TextBlock x:Name="RelayStatusText" Text="Checking…" FontSize="12"/></Border>
                    </WrapPanel>
                    <TextBlock x:Name="HomeSummaryText" Text="Listening for new achievements from your connected accounts." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,14"/>
                    <Button x:Name="HomePrimaryActionButton" Content="Send Discord test" Click="HomePrimaryAction_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="180" MinHeight="40" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Account and sync" Click="ShowAccount_Click" Margin="12,0,0,0"/><TextBlock x:Name="HomeAccountSummary" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite"/></DockPanel>
                    <Border Background="#10151D" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
                      <Grid MinHeight="120">
                        <Image x:Name="NowPlayingArtwork" Stretch="UniformToFill" Opacity="0.3"/>
                        <StackPanel Margin="16">
                          <TextBlock Text="NOW PLAYING" Foreground="#FF657B" FontSize="11" FontWeight="Bold"/>
                          <TextBlock x:Name="NowPlayingTitle" Text="Waiting for your next game" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"/>
                          <TextBlock x:Name="NowPlayingProgress" Text="Steam game detection · Xbox progress from verified snapshots" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <TextBlock x:Name="RelayStatusDetail" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource RedlinePanel}" Padding="8" Margin="0,0,0,10">
                  <Grid MinHeight="290">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Border Background="#10171D" CornerRadius="5" ClipToBounds="True" Margin="0,0,16,0">
                      <Grid><Image x:Name="RedlineHeroImage" Source="Assets/RelayCommandDeck.png" Stretch="Uniform"/>
                        <Border VerticalAlignment="Bottom" Padding="16,26,16,12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#EE000000" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock x:Name="RedlineGameText" Text="ACHIEVEMENT RELAY" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="Bold"/></Border>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,10,8,10" VerticalAlignment="Center">
                      <Border Background="#460017" BorderBrush="#BC1830" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock x:Name="RedlinePreviewLabel" Text="LOCAL PREVIEW" FontSize="11" Foreground="#FFBEC5"/></Border>
                      <TextBlock x:Name="RedlineAchievementText" Text="Your next achievement." FontSize="25" FontWeight="SemiBold" Margin="0,14,0,6"/>
                      <TextBlock x:Name="RedlineDescriptionText" Text="Your game artwork and unlock details will appear here after a successful delivery." FontSize="14" Foreground="#CCD0D5"/>
                      <TextBlock x:Name="RedlinePlatformText" Text="Xbox + Steam" Margin="0,16,0,8" Foreground="#EAEDEF" FontSize="14"/>
                      <TextBlock x:Name="RedlineRewardText" Text="Only proven live unlocks" Foreground="#D9BB7B" FontSize="13"/>
                      <Border BorderBrush="#373C41" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><TextBlock x:Name="RedlineDeliveryText" Text="No old achievements are reposted. Your existing history stays private." FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></Border>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource RedlinePanel}" Padding="14">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="View log" Click="ShowActivity_Click" Padding="8,4" MinHeight="28" HorizontalAlignment="Right"/><TextBlock Text="RECENT ACHIEVEMENTS" FontSize="12" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="RedlineEmptyText" Text="No achievements delivered in this session yet. Play normally — Relay will capture your next proven unlock." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,12"/>
                    <ListBox x:Name="RedlineAchievementsList" Background="Transparent" BorderThickness="0" MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="RedlineAchievementSelected">
                      <ListBox.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#252A30" BorderThickness="0,0,0,1" Padding="0,9">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Game}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Platform}" FontSize="11"/><TextBlock Text="✓ Delivered" Foreground="#79D58D" FontSize="11"/><TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Header="Latest relay messages" Margin="0,8,0,0"><ListBox x:Name="DashboardActivityList" MaxHeight="140" Background="Transparent" BorderThickness="0" DisplayMemberPath="Message" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Expander>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="HomeConnectionsColumn" Grid.Column="2">
                <Border Style="{StaticResource RedlinePanel}" Margin="0,0,0,10">
                  <StackPanel><TextBlock Text="CONNECTIONS" FontSize="12" Margin="0,0,0,10"/>
                    <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#182027" CornerRadius="7" Width="40" Height="40"><Image Source="Assets/Xbox.png" Width="28" Height="28"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="Xbox" FontSize="15"/><TextBlock x:Name="XboxStatusText" Text="Checking…" FontSize="12"/><TextBlock x:Name="XboxStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Manage" Click="GoToXboxSetup_Click" Padding="9,5" FontSize="11" MinHeight="32"/></Grid><Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#182027" CornerRadius="7" Width="40" Height="40"><Image Source="Assets/Steam.png" Width="28" Height="28"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="Steam" FontSize="15"/><TextBlock x:Name="SteamStatusText" Text="Checking…" FontSize="12"/><TextBlock x:Name="SteamStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Manage" Click="GoToSteamSetup_Click" Padding="9,5" FontSize="11" MinHeight="32"/></Grid><Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#182027" CornerRadius="7" Width="40" Height="40"><Image Source="Assets/Discord.png" Width="28" Height="28"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="Discord" FontSize="15"/><TextBlock x:Name="DiscordStatusText" Text="Checking…" FontSize="12"/><TextBlock x:Name="DiscordStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Manage" Click="GoToDiscordSetup_Click" Padding="9,5" FontSize="11" MinHeight="32"/></Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource RedlinePanel}">
                  <StackPanel>
                    <TextBlock Text="PRESENTATION" FontSize="12" Margin="0,0,0,18"/>
                    <DockPanel><CheckBox x:Name="RedlineOverlayToggle" DockPanel.Dock="Right" Style="{StaticResource RedlineToggle}" Click="RedlineOverlayToggle_Click" AutomationProperties.Name="Show Signal Strip overlay" HorizontalAlignment="Right"/><TextBlock Text="Signal Strip" FontSize="18" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock Text="Show a compact notification when you unlock an achievement." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,20"/>
                    <Button Content="Preview overlay" Click="PreviewAchievementOverlay_Click" Margin="0,0,0,10"/>

                    <TextBlock Text="A test sends a sample post to your configured Discord channel." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource RedlinePanel}" Padding="10">
                      <StackPanel><TextBlock Text="LOCAL SIGNAL STRIP PREVIEW" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/><Border BorderBrush="#FF1638" BorderThickness="3,0,0,0" Padding="10,5"><DockPanel><Image Source="Assets/AchievementRelay.png" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Achievement unlocked" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Text, ElementName=RedlineAchievementText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=RedlinePlatformText}" FontSize="11"/></StackPanel></DockPanel></Border></StackPanel>
                    </Border>
                    <Button Content="Presentation settings →" Click="ShowPresentation_Click" Margin="0,12,0,0" FontSize="12"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Guided setup -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Set up your relay" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Four short steps. Your old achievements stay private; only new unlocks are posted." />

            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,18" Padding="16,13">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SetupProgressText" Text="Step 1 of 4 · Choose platforms" FontWeight="SemiBold" Margin="0,0,18,0" />
                <ProgressBar x:Name="SetupProgressBar" Grid.Column="1" Minimum="0" Maximum="4" Value="1" VerticalAlignment="Center" AutomationProperties.Name="Setup progress" />
              </Grid>
            </Border>

            <TabControl x:Name="SetupSteps" Style="{StaticResource ContentTabControl}">
              <TabControl.Resources>
                <Style TargetType="TabItem">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </TabControl.Resources>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="Which achievements do you want to share?" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="Choose one or both. Steam needs no key; Xbox uses a free personal OpenXBL key." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SoftCard}" BorderBrush="{StaticResource XboxOutlineBrush}" Padding="18">
                          <CheckBox x:Name="SetupXboxSourceCheckBox" Click="SetupXboxSource_Click" AutomationProperties.Name="Share Xbox achievements">
                            <Grid Margin="4,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource XboxBrush}" VerticalAlignment="Top">
                                <Image Source="Assets/Xbox.png" Width="26" Height="26" />
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Xbox" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Xbox console and PC unlocks through OpenXBL." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,7" />
                                <TextBlock x:Name="SetupXboxChoiceStatus" Text="Not connected yet" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                              </StackPanel>
                            </Grid>
                          </CheckBox>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" BorderBrush="{StaticResource SteamOutlineBrush}" Padding="18">
                          <CheckBox x:Name="SetupSteamEnabledCheckBox" IsChecked="True" AutomationProperties.Name="Share Steam achievements">
                            <Grid Margin="4,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SteamBrush}" VerticalAlignment="Top">
                                <Image Source="Assets/Steam.png" Width="27" Height="27" />
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Steam" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Automatic local monitoring. No API key required." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,7" />
                                <TextBlock x:Name="SetupSteamStatus" Text="Checking this PC" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                              </StackPanel>
                            </Grid>
                          </CheckBox>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="SetupNextFromSources_Click" MinWidth="130" />
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource XboxBrush}" VerticalAlignment="Top">
                        <Image Source="Assets/Xbox.png" Width="30" Height="30" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Connect Xbox" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="OpenXBL provides the Xbox achievement feed. The personal key is encrypted for this Windows account." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,14">
                          <StackPanel>
                            <TextBlock Text="1  Get your free personal key" FontWeight="SemiBold" />
                            <TextBlock Text="Open OpenXBL, sign in with the Xbox account you want to monitor, then copy the API key from your profile." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,10" />
                            <Button Content="Open OpenXBL" Click="OpenOpenXbl_Click" HorizontalAlignment="Left" />
                          </StackPanel>
                        </Border>

                        <TextBlock Text="2  Paste the key" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid>
                            <PasswordBox x:Name="SetupXboxApiKeyPasswordBox" PasswordChar="●" ToolTip="OpenXBL API key" AutomationProperties.Name="OpenXBL API key" />
                            <TextBox x:Name="SetupXboxApiKeyRevealTextBox" Visibility="Collapsed" ToolTip="OpenXBL API key visible" AutomationProperties.Name="OpenXBL API key visible" />
                          </Grid>
                          <Button x:Name="SetupXboxApiKeyRevealButton" Grid.Column="1" Content="Reveal Key" Click="ToggleSetupXboxApiKeyVisibility_Click" Margin="9,0,0,0" />
                        </Grid>

                        <TextBlock Text="3  Verify the account" FontWeight="SemiBold" Margin="0,16,0,7" />
                        <Button Content="Connect Xbox" Style="{StaticResource PrimaryButton}" Click="SaveAndTestOpenXbl_Click" HorizontalAlignment="Left" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,15,0,0" Padding="14" BorderBrush="{StaticResource BorderBrush}">
                          <TextBlock x:Name="SetupXboxStatus" Text="Not connected yet" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackToSources_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="SkipXboxButton" Content="Skip Xbox" Click="SkipXboxSetup_Click" Margin="0,0,9,0" />
