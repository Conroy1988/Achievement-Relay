                        <Button Content="Save and send a test" Style="{StaticResource DiscordButton}" Click="SaveAndTestWebhook_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,15,0,0" Padding="14" BorderBrush="{StaticResource DiscordOutlineBrush}">
                          <TextBlock x:Name="SetupWebhookStatus" Text="Not connected yet" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackFromDiscord_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="SetupNextFromDiscord_Click" HorizontalAlignment="Right" MinWidth="130" />
                  </Grid>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="Make it yours" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="These defaults work well for most people. You can change them later in Settings." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Player name shown in Discord" Style="{StaticResource FieldLabel}" />
                          <TextBox x:Name="SetupDisplayNameTextBox" MaxLength="80" AutomationProperties.Name="Player name shown in Discord" />
                          <TextBlock Text="Leave blank to use your Xbox gamertag or Steam name." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,16" />
                          <CheckBox x:Name="SetupStartWithWindowsCheckBox" Content="Start Achievement Relay with Windows" IsChecked="True" />
                          <CheckBox x:Name="SetupStartMinimizedCheckBox" Content="Start quietly in the notification area" IsChecked="True" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="17">
                          <StackPanel>
                            <TextBlock Text="Ready check" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <TextBlock Text="ACHIEVEMENTS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="SetupReviewSourcesText" Text="Choose Xbox, Steam or both" Margin="0,3,0,13" FontWeight="SemiBold" />
                            <TextBlock Text="DESTINATION" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="SetupReviewDiscordText" Text="Connect Discord" Margin="0,3,0,13" FontWeight="SemiBold" />
                            <TextBlock Text="SAFE FIRST RUN" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Existing unlocks become a silent baseline. They are never reposted." Margin="0,3,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackFromFinish_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Send another Discord test" Click="SendSampleAchievement_Click" Margin="0,0,9,0" />
                      <Button Content="Finish setup" Style="{StaticResource PrimaryButton}" Click="FinishSetup_Click" MinWidth="145" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Activity -->
      <TabItem>
        <Grid Margin="34,28,34,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
          <StackPanel Grid.Row="1"><TextBlock Style="{StaticResource PageSubtitle}" Text="What Relay has done, newest first. Warnings include the next step where one is needed."/><TextBox x:Name="ActivitySearchBox" AutomationProperties.Name="Search relay activity" ToolTip="Search the activity messages" TextChanged="ActivityFilterChanged"/><CheckBox x:Name="ActivityAttentionOnly" Content="Only show warnings and errors" Checked="ActivityFilterChanged" Unchecked="ActivityFilterChanged" Margin="0,8,0,12"/></StackPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Relay activity history">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#20E8E1D5" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>

      <!-- Settings -->
      <TabItem>
        <DockPanel LastChildFill="True"><Border DockPanel.Dock="Bottom" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">            <StackPanel><TextBlock x:Name="SettingsSaveStatus" Foreground="{StaticResource TextBrush}" Text="Your settings are saved." AutomationProperties.LiveSetting="Polite" Margin="0,8"/><WrapPanel HorizontalAlignment="Right"><Button Content="Discard edits" Click="DiscardSettings_Click" Margin="0,0,10,0"/>
              <Button x:Name="SavePreferencesButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" MinWidth="145" />
            </WrapPanel></StackPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <WrapPanel><Button Content="Xbox" Tag="xbox" Click="SettingsSection_Click" Margin="0,0,8,8"/><Button Content="Discord posting" Tag="discord" Click="SettingsSection_Click" Margin="0,0,8,8"/><Button Content="Windows" Tag="windows" Click="SettingsSection_Click" Margin="0,0,8,8"/><Button Content="Overlay and sound" Tag="overlay" Click="SettingsSection_Click" Margin="0,0,8,8"/></WrapPanel>
            <Button Content="Relay account — Discord login and encrypted sync" Click="ShowAccount_Click" HorizontalAlignment="Left" Margin="0,8,0,12" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Change a connection or preference. Preferences apply when you select Save settings. Connection checks and disconnect actions are labelled separately." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
