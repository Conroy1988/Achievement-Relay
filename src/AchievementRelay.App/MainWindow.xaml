                  </Border>
                </StackPanel>
              </Expander>
            </Border>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/AchievementRelay.png" Width="56" Height="56" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Achievement Relay" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="AboutVersionText" Text="Version 0.11.0" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" Margin="0,2,0,9" />
                  <TextBlock Text="Xbox and Steam achievements relayed to the Discord channel you choose. Secrets are encrypted locally; Steam monitoring is local and read-only." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button Content="Privacy" Click="OpenPrivacyPolicy_Click" Margin="0,0,8,8" />
                    <Button Content="Third-party notices" Click="OpenArtLicenses_Click" Margin="0,0,8,8" />
                    <Button Content="GitHub" Click="OpenGitHub_Click" Margin="0,0,8,8" />
                    <Button Content="OpenXBL" Click="OpenOpenXbl_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Presentation is a local inspector; a preview never sends a Discord post. -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,16,24,30">
            <TextBlock Text="Presentation" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Inspect your latest delivered Collector Card and preview the in-game Signal Strip." Style="{StaticResource PageSubtitle}"/>
            <Border Style="{StaticResource RedlinePanel}">
              <StackPanel><TextBlock Text="COLLECTOR CARD · LAST SELECTED DELIVERY" FontSize="12" Margin="0,0,0,15"/>
                <TextBlock x:Name="RedlineCollectorEmpty" Text="Your next successfully delivered Collector Card will appear here. If artwork is unavailable, Relay uses its branded fallback." Margin="0,20" Foreground="{StaticResource MutedTextBrush}"/>
                <Image x:Name="RedlineCollectorImage" Stretch="Uniform" MaxHeight="460" AutomationProperties.Name="Collector Card from selected delivery"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RedlinePanel}" Margin="0,14,0,0">
              <StackPanel><TextBlock Text="Signal Strip" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="A local preview of your overlay and sound settings. It does not post to Discord. Duration and placement are configurable." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,16"/>
                <WrapPanel><Button Content="Preview Signal Strip" Click="PreviewAchievementOverlay_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button Content="Size, screen and appearance" Click="OpenPresentationControls_Click" Margin="0,0,0,8"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
  </Border>
</Window>
