                    </StackPanel>
                  </Grid>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                        <Image Source="Assets/Discord.png" Width="31" Height="31" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Choose where achievements are posted" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="A Discord webhook belongs to one channel. Achievement Relay stores it with Windows encryption." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,14">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="In Discord" FontWeight="SemiBold" />
                              <TextBlock Text="Server Settings → Integrations → Webhooks → New Webhook → choose a channel → Copy Webhook URL" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Official guide" Click="OpenDiscordWebhookGuide_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                          </Grid>
                        </Border>

                        <TextBlock Text="Paste the webhook URL" Style="{StaticResource FieldLabel}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid>
                            <PasswordBox x:Name="SetupWebhookPasswordBox" PasswordChar="●" ToolTip="Discord webhook URL" AutomationProperties.Name="Discord webhook URL" />
                            <TextBox x:Name="SetupWebhookRevealTextBox" Visibility="Collapsed" ToolTip="Discord webhook URL visible" AutomationProperties.Name="Discord webhook URL visible" />
                          </Grid>
                          <Button x:Name="SetupWebhookRevealButton" Grid.Column="1" Content="Reveal Webhook" Click="ToggleSetupWebhookVisibility_Click" Margin="9,0,0,0" />
