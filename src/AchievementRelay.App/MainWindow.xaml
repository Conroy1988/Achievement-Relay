<Window x:Class="AchievementRelay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Relay"
        Width="1180"
        Height="800"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource SidebarSurfaceBrush}"
            BorderBrush="#26364A"
            BorderThickness="0,0,1,0">
      <Grid Margin="15">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="6,8,0,28">
          <Border Width="44" Height="44" CornerRadius="12" Background="#1A5CE1A8" BorderBrush="#485CE1A8" BorderThickness="1">
            <Image Source="Assets/AchievementRelay.png" Width="36" Height="36" Stretch="Uniform" />
          </Border>
          <StackPanel Margin="10,3,0,0">
            <TextBlock Text="Achievement" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="Relay" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18" Margin="0,-2,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <TextBlock Text="MENU" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,7" />
          <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonActive}" Click="ShowDashboard_Click" AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⌂" Width="25" FontSize="17" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SetupNavButton" Style="{StaticResource NavButton}" Click="ShowSetup_Click" AutomationProperties.Name="Setup">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="1·2·3" Width="38" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="Setup" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ActivityNavButton" Style="{StaticResource NavButton}" Click="ShowActivity_Click" AutomationProperties.Name="Activity history">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↻" Width="25" FontSize="17" />
              <TextBlock Text="Activity" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" Width="25" FontSize="16" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Click="ShowDiagnostics_Click" AutomationProperties.Name="Help and support">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="?" Width="25" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="Help &amp; support" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Border Style="{StaticResource SoftCard}" Padding="12" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="RELAY STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              <TextBlock x:Name="SidebarMonitorStatus" Text="Checking…" Margin="0,5,0,0" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
          </Border>
          <Button Content="☕  Support on Ko-fi"
                  Style="{StaticResource KoFiButton}"
                  Click="OpenKoFi_Click"
                  Padding="10,7"
                  MinHeight="36"
                  FontSize="11"
                  AutomationProperties.Name="Support Achievement Relay on Ko-fi" />
          <TextBlock Text="Runs quietly in your tray" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,1" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </TabControl.Resources>

      <!-- Home -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,26,32,38">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="One glance tells you whether Achievement Relay is ready." />

            <Border x:Name="UpdateBanner" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,0,16" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="#2AF4C96B" VerticalAlignment="Top">
                  <TextBlock Text="↓" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,22,0">
                  <TextBlock x:Name="UpdateBannerTitle" Text="Achievement Relay update" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="UpdateBannerMessage" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <ProgressBar x:Name="UpdateBannerProgress" Margin="0,11,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="UpdateBannerNotesButton" Content="Release notes" Click="OpenUpdateNotes_Click" Margin="0,0,8,0" />
                  <Button x:Name="UpdateBannerActionButton" Content="Update now" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click" />
                </WrapPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="#405CE1A8" Padding="24" Margin="0,0,0,22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="17" Background="#1C5CE1A8" BorderBrush="#505CE1A8" BorderThickness="1" VerticalAlignment="Top">
                  <Image Source="Assets/AchievementRelay.png" Width="46" Height="46" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,24,0">
                  <Border Style="{StaticResource StatusPill}">
                    <TextBlock x:Name="RelayStatusText" Text="Checking" FontSize="11" FontWeight="Bold" />
                  </Border>
                  <TextBlock x:Name="HomeTitleText" Text="Checking your relay…" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,5" />
                  <TextBlock x:Name="HomeSummaryText" Text="Achievement Relay is checking Xbox, Steam and Discord." Foreground="{StaticResource MutedTextBrush}" FontSize="14" MaxWidth="620" HorizontalAlignment="Left" />
                  <TextBlock x:Name="RelayStatusDetail" Text="Multi-platform monitoring" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="HomePrimaryActionButton" Content="Open setup" Style="{StaticResource PrimaryButton}" Click="HomePrimaryAction_Click" MinWidth="156" />
                  <Button Content="Manage setup" Click="ShowSetup_Click" Margin="0,8,0,0" MinWidth="156" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="Your connections" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource XboxBrush}">
                      <Image Source="Assets/Xbox.png" Width="26" Height="26" />
                    </Border>
                    <StackPanel Margin="11,1,0,0">
                      <TextBlock Text="Xbox" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="via OpenXBL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,15,0,14">
                    <TextBlock x:Name="XboxStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="XboxStatusDetail" Text="OpenXBL connection" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button Grid.Row="2" Content="Manage Xbox" Click="GoToXboxSetup_Click" HorizontalAlignment="Left" Padding="12,7" MinHeight="34" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SteamBrush}">
                      <Image Source="Assets/Steam.png" Width="27" Height="27" />
                    </Border>
                    <StackPanel Margin="11,1,0,0">
                      <TextBlock Text="Steam" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="local, no key" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,15,0,14">
                    <TextBlock x:Name="SteamStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SteamStatusDetail" Text="Local Steam client" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Row="2" Content="Manage Steam" Click="GoToSteamSetup_Click" HorizontalAlignment="Left" Padding="12,7" MinHeight="34" />
                </Grid>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource DiscordBrush}">
                      <Image Source="Assets/Discord.png" Width="28" Height="28" />
                    </Border>
                    <StackPanel Margin="11,1,0,0">
                      <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="your destination" Foreground="#D5D8FF" FontSize="10" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,15,0,14">
                    <TextBlock x:Name="DiscordStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DiscordStatusDetail" Text="Webhook destination" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button Grid.Row="2" Content="Manage Discord" Click="GoToDiscordSetup_Click" HorizontalAlignment="Left" Padding="12,7" MinHeight="34" />
                </Grid>
              </Border>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="6*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="What happens next" Style="{StaticResource SectionTitle}" />
                  <Grid Margin="0,2,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="25" Height="25" CornerRadius="13" Background="#245CE1A8">
                      <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Play normally" FontWeight="SemiBold" />
                      <TextBlock Text="Achievement Relay waits quietly in your tray." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="25" Height="25" CornerRadius="13" Background="#245CE1A8">
                      <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Unlock an achievement" FontWeight="SemiBold" />
                      <TextBlock Text="Only new, proven unlocks are selected." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="25" Height="25" CornerRadius="13" Background="#245865F2">
                      <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="See it in Discord" FontWeight="SemiBold" />
                      <TextBlock Text="The post includes the game, rarity and artwork when available." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" />
                    <Button Content="View all" Click="ShowActivity_Click" HorizontalAlignment="Right" Padding="11,5" MinHeight="30" FontSize="11" />
                  </Grid>
                  <ListBox x:Name="DashboardActivityList" Grid.Row="1" Background="Transparent" BorderThickness="0" MaxHeight="230" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#25364A" BorderThickness="0,0,0,1" Padding="0,9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="62" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,2,0,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Guided setup -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Set up your relay" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Four short steps. Your old achievements stay private; only new unlocks are posted." />

            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,18" Padding="16,13">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SetupProgressText" Text="Step 1 of 4 · Choose platforms" FontWeight="SemiBold" Margin="0,0,18,0" />
                <ProgressBar x:Name="SetupProgressBar" Grid.Column="1" Minimum="0" Maximum="4" Value="1" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <TabControl x:Name="SetupSteps" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False">
              <TabControl.Resources>
                <Style TargetType="TabItem">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </TabControl.Resources>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="Which achievements do you want to share?" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="Choose one or both. Steam needs no key; Xbox uses a free personal OpenXBL key." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SoftCard}" BorderBrush="#68107C10" Padding="18">
                          <CheckBox x:Name="SetupXboxSourceCheckBox" Click="SetupXboxSource_Click" AutomationProperties.Name="Share Xbox achievements">
                            <Grid Margin="4,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource XboxBrush}" VerticalAlignment="Top">
                                <Image Source="Assets/Xbox.png" Width="26" Height="26" />
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Xbox" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Xbox console and PC unlocks through OpenXBL." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,7" />
                                <TextBlock x:Name="SetupXboxChoiceStatus" Text="Not connected yet" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                              </StackPanel>
                            </Grid>
                          </CheckBox>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" BorderBrush="#681B6D91" Padding="18">
                          <CheckBox x:Name="SetupSteamEnabledCheckBox" IsChecked="True" AutomationProperties.Name="Share Steam achievements">
                            <Grid Margin="4,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SteamBrush}" VerticalAlignment="Top">
                                <Image Source="Assets/Steam.png" Width="27" Height="27" />
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Steam" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Automatic local monitoring. No API key required." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,7" />
                                <TextBlock x:Name="SetupSteamStatus" Text="Checking this PC" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                              </StackPanel>
                            </Grid>
                          </CheckBox>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="SetupNextFromSources_Click" MinWidth="130" />
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource XboxBrush}" VerticalAlignment="Top">
                        <Image Source="Assets/Xbox.png" Width="30" Height="30" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Connect Xbox" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="OpenXBL provides the Xbox achievement feed. The personal key is encrypted for this Windows account." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,14">
                          <StackPanel>
                            <TextBlock Text="1  Get your free personal key" FontWeight="SemiBold" />
                            <TextBlock Text="Open OpenXBL, sign in with the Xbox account you want to monitor, then copy the API key from your profile." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,10" />
                            <Button Content="Open OpenXBL" Click="OpenOpenXbl_Click" HorizontalAlignment="Left" />
                          </StackPanel>
                        </Border>

                        <TextBlock Text="2  Paste the key" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid>
                            <PasswordBox x:Name="SetupXboxApiKeyPasswordBox" PasswordChar="●" ToolTip="OpenXBL API key" AutomationProperties.Name="OpenXBL API key" />
                            <TextBox x:Name="SetupXboxApiKeyRevealTextBox" Visibility="Collapsed" ToolTip="OpenXBL API key visible" AutomationProperties.Name="OpenXBL API key visible" />
                          </Grid>
                          <Button x:Name="SetupXboxApiKeyRevealButton" Grid.Column="1" Content="Reveal Key" Click="ToggleSetupXboxApiKeyVisibility_Click" Margin="9,0,0,0" />
                        </Grid>

                        <TextBlock Text="3  Verify the account" FontWeight="SemiBold" Margin="0,16,0,7" />
                        <Button Content="Connect Xbox" Style="{StaticResource PrimaryButton}" Click="SaveAndTestOpenXbl_Click" HorizontalAlignment="Left" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,15,0,0" Padding="14" BorderBrush="#454F6074">
                          <TextBlock x:Name="SetupXboxStatus" Text="Not connected yet" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackToSources_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="SkipXboxButton" Content="Skip Xbox" Click="SkipXboxSetup_Click" Margin="0,0,9,0" />
                      <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="SetupNextFromXbox_Click" MinWidth="130" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                        <Image Source="Assets/Discord.png" Width="31" Height="31" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Choose where achievements are posted" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="A Discord webhook belongs to one channel. Achievement Relay stores it with Windows encryption." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,14">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="In Discord" FontWeight="SemiBold" />
                              <TextBlock Text="Server Settings → Integrations → Webhooks → New Webhook → choose a channel → Copy Webhook URL" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Official guide" Click="OpenDiscordWebhookGuide_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                          </Grid>
                        </Border>

                        <TextBlock Text="Paste the webhook URL" Style="{StaticResource FieldLabel}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid>
                            <PasswordBox x:Name="SetupWebhookPasswordBox" PasswordChar="●" ToolTip="Discord webhook URL" AutomationProperties.Name="Discord webhook URL" />
                            <TextBox x:Name="SetupWebhookRevealTextBox" Visibility="Collapsed" ToolTip="Discord webhook URL visible" AutomationProperties.Name="Discord webhook URL visible" />
                          </Grid>
                          <Button x:Name="SetupWebhookRevealButton" Grid.Column="1" Content="Reveal Webhook" Click="ToggleSetupWebhookVisibility_Click" Margin="9,0,0,0" />
                        </Grid>

                        <Button Content="Save and send a test" Style="{StaticResource DiscordButton}" Click="SaveAndTestWebhook_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,15,0,0" Padding="14" BorderBrush="#455865F2">
                          <TextBlock x:Name="SetupWebhookStatus" Text="Not connected yet" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackFromDiscord_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="SetupNextFromDiscord_Click" HorizontalAlignment="Right" MinWidth="130" />
                  </Grid>
                </StackPanel>
              </TabItem>

              <TabItem>
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="Make it yours" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="These defaults work well for most people. You can change them later in Settings." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Player name shown in Discord" Style="{StaticResource FieldLabel}" />
                          <TextBox x:Name="SetupDisplayNameTextBox" MaxLength="80" AutomationProperties.Name="Player name shown in Discord" />
                          <TextBlock Text="Leave blank to use your Xbox gamertag or Steam name." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,6,0,16" />
                          <CheckBox x:Name="SetupStartWithWindowsCheckBox" Content="Start Achievement Relay with Windows" IsChecked="True" />
                          <CheckBox x:Name="SetupStartMinimizedCheckBox" Content="Start quietly in the notification area" IsChecked="True" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="17">
                          <StackPanel>
                            <TextBlock Text="Ready check" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <TextBlock Text="ACHIEVEMENTS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="SetupReviewSourcesText" Text="Choose Xbox, Steam or both" Margin="0,3,0,13" FontWeight="SemiBold" />
                            <TextBlock Text="DESTINATION" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="SetupReviewDiscordText" Text="Connect Discord" Margin="0,3,0,13" FontWeight="SemiBold" />
                            <TextBlock Text="SAFE FIRST RUN" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Existing unlocks become a silent baseline. They are never reposted." Margin="0,3,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Grid>
                    <Button Content="Back" Click="SetupBackFromFinish_Click" HorizontalAlignment="Left" MinWidth="100" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Send another Discord test" Click="SendSampleAchievement_Click" Margin="0,0,9,0" />
                      <Button Content="Finish setup" Style="{StaticResource PrimaryButton}" Click="FinishSetup_Click" MinWidth="145" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Activity -->
      <TabItem>
        <Grid Margin="34,28,34,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
          <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="A plain-language history of what the relay has done. Newest events appear first." />
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#26374A" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>

      <!-- Settings -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Change a connection or preference. Nothing is applied until you select Save settings." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource XboxBrush}" VerticalAlignment="Top">
                  <Image Source="Assets/Xbox.png" Width="26" Height="26" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Xbox" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsXboxStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                  <TextBlock Text="OpenXBL API key" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <PasswordBox x:Name="SettingsXboxApiKeyPasswordBox" PasswordChar="●" AutomationProperties.Name="Saved OpenXBL API key" />
                    <TextBox x:Name="SettingsXboxApiKeyRevealTextBox" Visibility="Collapsed" AutomationProperties.Name="Saved OpenXBL API key visible" />
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SettingsXboxApiKeyRevealButton" Content="Reveal Key" Click="ToggleSettingsXboxApiKeyVisibility_Click" Margin="0,0,8,8" />
                    <Button Content="Get API key" Click="OpenOpenXbl_Click" Margin="0,0,8,8" />
                    <Button Content="Retry or replace" Click="SaveAndTestSettingsOpenXbl_Click" Margin="0,0,8,8" />
                    <Button Content="Disconnect Xbox" Style="{StaticResource DangerButton}" Click="RemoveOpenXbl_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SteamBrush}" VerticalAlignment="Top">
                  <Image Source="Assets/Steam.png" Width="27" Height="27" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Steam" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsSteamStatus" Text="Checking the local Steam installation" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10" />
                  <CheckBox x:Name="SettingsSteamEnabledCheckBox" Content="Monitor Steam achievements automatically" />
                  <Button Content="Refresh Steam detection" Click="RefreshSteam_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                  <Image Source="Assets/Discord.png" Width="28" Height="28" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Discord" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsWebhookStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                  <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <PasswordBox x:Name="SettingsWebhookPasswordBox" PasswordChar="●" AutomationProperties.Name="Saved Discord webhook URL" />
                    <TextBox x:Name="SettingsWebhookRevealTextBox" Visibility="Collapsed" AutomationProperties.Name="Saved Discord webhook URL visible" />
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SettingsWebhookRevealButton" Content="Reveal Webhook" Click="ToggleSettingsWebhookVisibility_Click" Margin="0,0,8,8" />
                    <Button Content="Test Discord" Click="TestSettingsWebhook_Click" Margin="0,0,8,8" />
                    <Button Content="Remove webhook" Style="{StaticResource DangerButton}" Click="RemoveWebhook_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                  <TextBlock Text="Name shown above Discord posts" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                  <TextBox x:Name="SettingsDiscordUsernameTextBox" MaxLength="80" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Achievement posts" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Player name shown in Discord" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="SettingsDisplayNameTextBox" MaxLength="80" />
                  <CheckBox x:Name="SettingsRareOnlyCheckBox" Content="Only post achievements confirmed as rare" Margin="0,13,0,4" />
                  <CheckBox x:Name="SettingsRawDetailsCheckBox" Content="Include the achievement description" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                  <CheckBox x:Name="SettingsStartWithWindowsCheckBox" Content="Start Achievement Relay with Windows" />
                  <CheckBox x:Name="SettingsStartMinimizedCheckBox" Content="Start quietly in the notification area" />
                  <TextBlock Text="Closing the window keeps monitoring active in the tray." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" MinWidth="145" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Help and support -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Help &amp; support" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Quick checks first, technical detail only when you need it." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Try these first" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Each check is safe. It will not repost old achievements." Foreground="{StaticResource MutedTextBrush}" Margin="0,-3,0,13" />
                <WrapPanel>
                  <Button Content="Sync Xbox now" Style="{StaticResource PrimaryButton}" Click="SyncNow_Click" Margin="0,0,8,8" />
                  <Button Content="Refresh Steam" Click="RefreshSteam_Click" Margin="0,0,8,8" />
                  <Button Content="Send Discord test" Click="SendSampleAchievement_Click" Margin="0,0,8,8" />
                  <Button Content="Copy support summary" Click="CopySupportSummary_Click" Margin="0,0,8,8" />
                  <Button Content="Open local data" Click="OpenDataFolder_Click" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="#6B5CE1A8" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock Text="App updates" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="AboutUpdateStatusText" Text="Updates have not been checked yet." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                  <TextBlock x:Name="AboutUpdateCheckedText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="AboutUpdateNotesButton" Content="Release notes" Click="OpenUpdateNotes_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                  <Button Content="Check now" Click="CheckForUpdates_Click" Margin="0,0,8,0" />
                  <Button x:Name="AboutUpdateActionButton" Content="Update now" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click" Visibility="Collapsed" />
                </WrapPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="#70FF5E5B" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="Support independent development" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Achievement Relay is free. If it makes sharing your wins easier, you can support future development on Ko-fi." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="☕  Support on Ko-fi" Style="{StaticResource KoFiButton}" Click="OpenKoFi_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Expander Header="Technical status" IsExpanded="False">
                <StackPanel Margin="0,14,0,0">
                  <TextBlock Text="This detail is useful when troubleshooting or asking for support." Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal" Margin="0,0,0,10" />
                  <Border Style="{StaticResource SoftCard}">
                    <TextBlock x:Name="DiagnosticsStatusText" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Normal" />
                  </Border>
                </StackPanel>
              </Expander>
            </Border>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/AchievementRelay.png" Width="56" Height="56" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Achievement Relay" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="AboutVersionText" Text="Version 0.3.0 beta" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,9" />
                  <TextBlock Text="Xbox and Steam achievements relayed to the Discord channel you choose. Secrets are encrypted locally; Steam monitoring is local and read-only." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button Content="Privacy" Click="OpenPrivacyPolicy_Click" Margin="0,0,8,8" />
                    <Button Content="Third-party notices" Click="OpenArtLicenses_Click" Margin="0,0,8,8" />
                    <Button Content="GitHub" Click="OpenGitHub_Click" Margin="0,0,8,8" />
                    <Button Content="OpenXBL" Click="OpenOpenXbl_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
