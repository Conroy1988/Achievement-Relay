<Window x:Class="AchievementRelay.App.AchievementOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        AutomationProperties.LiveSetting="Polite">
  <Grid x:Name="OverlayRoot"
        Width="520"
        Height="76"
        Opacity="1"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="OverlayTranslate" Y="0" />
    </Grid.RenderTransform>

    <Border x:Name="OverlayFrame"
            Margin="2"
            Background="#FA0B0D10"
            BorderBrush="#FF737B7E"
            BorderThickness="1"
            CornerRadius="9"
            TextElement.Foreground="#FFF4F1EB">
      <Border.Effect>
        <DropShadowEffect BlurRadius="11" ShadowDepth="3" Opacity="0.58" Color="#FF000000" />
      </Border.Effect>

      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="2" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle x:Name="SignalLine"
                   Grid.Row="0"
                   Fill="#FFD72B32" />

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="132" />
          </Grid.ColumnDefinitions>

          <Border x:Name="ArtworkFrame"
                  Grid.Column="0"
                  Width="52"
                  Height="52"
                  Margin="8,5,6,5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#FF171C20"
                  BorderBrush="#FF656E72"
                  BorderThickness="1"
                  CornerRadius="7"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="AchievementArtwork"
                     Visibility="Collapsed"
                     Stretch="UniformToFill" />
              <Grid x:Name="FallbackArtwork"
                    Background="#FF111519">
                <Image Source="Assets/AchievementRelay.png"
                       Width="38"
                       Height="38"
                       Stretch="Uniform"
                       Opacity="0.96" />
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Column="1" Margin="0,5,10,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="EyebrowText"
                       Grid.Row="0"
                       Foreground="#FFFF7278"
                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                       FontSize="11"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="AchievementNameText"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       Foreground="#FFF7F4EE"
                       FontFamily="Bahnschrift SemiCondensed, Segoe UI Variable Display, Segoe UI"
                       FontSize="18"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="GameAndRewardText"
                       Grid.Row="2"
                       Foreground="#FFC0C6C9"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </Grid>

          <Border x:Name="RarityPanel"
                  Grid.Column="2"
                  Background="#2CDA9E23"
                  BorderBrush="#66737B7E"
                  BorderThickness="1,0,0,0"
                  Padding="8,5,9,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                <Path x:Name="TierGlyph"
                      Data="M12,0 L15,5 L20.5,3.5 L19,9 L24,12 L19,15 L20.5,20.5 L15,19 L12,24 L9,19 L3.5,20.5 L5,15 L0,12 L5,9 L3.5,3.5 L9,5 Z"
                      Fill="#FFFFE078"
                      Stretch="Uniform" />
                <TextBlock x:Name="TierGlyphMark"
                           Text="G"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF201500"
                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                           FontSize="11"
                           FontWeight="Bold" />
              </Grid>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="RarityPercentageText"
                           Text="4.7%"
                           HorizontalAlignment="Right"
                           Foreground="#FFFFE078"
                           FontFamily="Bahnschrift SemiCondensed, Segoe UI Variable Display, Segoe UI"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="TierNameText"
                           Text="Gold tier"
                           HorizontalAlignment="Right"
                           Foreground="#FFF1D797"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
