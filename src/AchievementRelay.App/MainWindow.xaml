                  <Image Source="Assets/Xbox.png" Width="26" Height="26" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Xbox" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsXboxStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,6" />
                  <TextBlock Text="For multiple PCs, use Account sync to coordinate Discord posts. Without coordination, each PC posts independently." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <TextBlock Text="OpenXBL API key" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <PasswordBox x:Name="SettingsXboxApiKeyPasswordBox" PasswordChar="●" AutomationProperties.Name="Saved OpenXBL API key" />
                    <TextBox x:Name="SettingsXboxApiKeyRevealTextBox" Visibility="Collapsed" AutomationProperties.Name="Saved OpenXBL API key visible" />
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SettingsXboxApiKeyRevealButton" Content="Reveal Key" Click="ToggleSettingsXboxApiKeyVisibility_Click" Margin="0,0,8,8" />
                    <Button Content="Get API key" Click="OpenOpenXbl_Click" Margin="0,0,8,8" />
                    <Button Content="Verify and save key" Click="SaveAndTestSettingsOpenXbl_Click" Margin="0,0,8,8" />
                    <Button Content="Disconnect Xbox" Style="{StaticResource DangerButton}" Click="RemoveOpenXbl_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SteamBrush}" VerticalAlignment="Top">
                  <Image Source="Assets/Steam.png" Width="27" Height="27" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Steam" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsSteamStatus" Text="Checking the local Steam installation" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10" />
                  <CheckBox x:Name="SettingsSteamEnabledCheckBox" Content="Monitor Steam achievements automatically" />
                  <Button Content="Refresh Steam detection" Click="RefreshSteam_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                  <Image Source="Assets/Discord.png" Width="28" Height="28" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Discord" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="SettingsWebhookStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                  <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <PasswordBox x:Name="SettingsWebhookPasswordBox" PasswordChar="●" AutomationProperties.Name="Saved Discord webhook URL" />
                    <TextBox x:Name="SettingsWebhookRevealTextBox" Visibility="Collapsed" AutomationProperties.Name="Saved Discord webhook URL visible" />
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SettingsWebhookRevealButton" Content="Reveal Webhook" Click="ToggleSettingsWebhookVisibility_Click" Margin="0,0,8,8" />
                    <Button Content="Test Discord" Click="TestSettingsWebhook_Click" Margin="0,0,8,8" />
                    <Button Content="Remove webhook" Style="{StaticResource DangerButton}" Click="RemoveWebhook_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                  <TextBlock Text="Name shown above Discord posts" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                  <TextBox x:Name="SettingsDiscordUsernameTextBox" MaxLength="80" AutomationProperties.Name="Name shown above Discord posts" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Achievement posts" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Player name shown in Discord" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="SettingsDisplayNameTextBox" MaxLength="80" AutomationProperties.Name="Player name shown in Discord" />
                  <CheckBox x:Name="SettingsRareOnlyCheckBox" Content="Only post achievements confirmed as rare" Margin="0,13,0,4" />
                  <CheckBox x:Name="SettingsRawDetailsCheckBox" Content="Include the achievement description" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="This PC · Windows" Style="{StaticResource SectionTitle}" />
                  <CheckBox x:Name="SettingsStartWithWindowsCheckBox" Content="Start Achievement Relay with Windows" />
                  <CheckBox x:Name="SettingsStartMinimizedCheckBox" Content="Start quietly in the notification area" />
                  <TextBlock Text="Closing the window keeps monitoring active in the tray." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#24D8B878" BorderBrush="{StaticResource LegendaryBrush}" BorderThickness="1" VerticalAlignment="Top">
                  <Image Source="Assets/TrophyCup.png" Width="27" Height="27" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="In-game achievement overlay" Style="{StaticResource SectionTitle}" />
                  <CheckBox x:Name="SettingsAchievementOverlayEnabledCheckBox"
                            Content="Show the Signal Strip when an achievement unlocks"
                            AutomationProperties.HelpText="A five-second banner appears at the top centre without taking focus or blocking clicks. Animation and sound are independently configurable." />
                  <TextBlock Text="Five-second banner with an optional Redline unlock animation and chime. It never takes focus or blocks clicks. Supported over windowed and borderless games; true exclusive fullscreen can hide desktop overlays like this one."
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,7,0,10" />
                  <CheckBox x:Name="SettingsOverlayAnimationCheckBox" Content="Animate unlocks — crimson sweep, icon pulse and rarity shimmer" Click="OverlayMotionPreference_Click"/>
                  <CheckBox x:Name="SettingsOverlayReducedMotionCheckBox" Content="Reduced motion — simple fade only" Click="OverlayMotionPreference_Click"/>
                  <CheckBox x:Name="SettingsOverlayFollowWindowsCheckBox" Content="Follow Windows animation preference" Click="OverlayMotionPreference_Click"/>
                  <TextBlock x:Name="OverlayMotionStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
                  <CheckBox x:Name="SettingsOverlaySoundCheckBox" Content="Play the original Relay unlock chime"/>
                  <DockPanel Margin="0,8,0,12">
                    <TextBlock Text="Chime volume" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=SettingsOverlayVolumeSlider, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Slider x:Name="SettingsOverlayVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="15" AutomationProperties.Name="Unlock chime volume percent"/>
                  </DockPanel>
                  <TextBlock Text="Relay uses your motion controls unless Follow Windows is selected. High-contrast mode always suppresses motion. Test unlock is local only and uses these controls without saving them." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <Button Content="Restore overlay and sound defaults" Click="ResetOverlayDefaults_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                  <Button x:Name="TestUnlockButton" Content="Test unlock — animation and sound"
                          Click="PreviewAchievementOverlay_Click"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </Border>


          </StackPanel>
        </ScrollViewer></DockPanel>
      </TabItem>

      <!-- Help and support -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,46">
            <TextBlock Style="{StaticResource PageTitle}" Text="Help &amp; support" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Find your way around" Style="{StaticResource SectionTitle}"/><TextBlock Text="Home shows monitoring and recent activity. Connections guides you through setup. Companion contains your library, trophies, sound and detailed overlay controls. Settings manages posting and this PC. Account pairs your PCs using Discord login; it does not choose the channel where achievements are posted."/><TextBlock Text="F1 opens Help. Ctrl+S saves Settings. Closing this window keeps Relay in the tray; choose Exit in the tray menu to stop it." Margin="0,10,0,0"/><TextBlock Text="For another PC: sign in with the same Discord account, enter your saved recovery key, then sync. If the key is lost, copy it from a PC that is still unlocked. The cloud service cannot recover it." Margin="0,10,0,0"/></StackPanel></Border>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Quick checks first, technical detail only when you need it." />

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentOutlineBrush}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="6" Background="#2E5865F2" BorderBrush="{StaticResource DiscordOutlineBrush}" BorderThickness="1" VerticalAlignment="Top">
                  <Image Source="Assets/Discord.png" Width="29" Height="29" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock Text="Community &amp; support" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="Get setup help, share feedback, follow development and meet the Achievement Relay community on Discord." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource CommunityButton}"
                        Click="OpenCommunityDiscord_Click"
                        VerticalAlignment="Center"
                        MinWidth="142"
                        AutomationProperties.Name="Join the Achievement Relay community Discord">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="Assets/Discord.png" Width="17" Height="17" Margin="0,0,8,0" />
                    <TextBlock Text="Join Discord" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Try these first" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Each check is safe. It will not repost old achievements." Foreground="{StaticResource MutedTextBrush}" Margin="0,-3,0,13" />
                <WrapPanel>
                  <Button Content="Sync Xbox now" Style="{StaticResource PrimaryButton}" Click="SyncNow_Click" Margin="0,0,8,8" />
                  <Button Content="Refresh Steam" Click="RefreshSteam_Click" Margin="0,0,8,8" />
                  <Button Content="Send Discord test" Click="SendSampleAchievement_Click" Margin="0,0,8,8" />
                  <Button Content="Copy support summary" Click="CopySupportSummary_Click" Margin="0,0,8,8" />
                  <Button Content="Open local data" Click="OpenDataFolder_Click" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentOutlineBrush}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock Text="App updates" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="AboutUpdateStatusText" Text="Updates have not been checked yet." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="AboutUpdateCheckedText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="AboutUpdateNotesButton" Content="Release notes" Click="OpenUpdateNotes_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                  <Button Content="Check now" Click="CheckForUpdates_Click" Margin="0,0,8,0" />
                  <Button x:Name="AboutUpdateActionButton" Content="Update now" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click" Visibility="Collapsed" />
                </WrapPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource KoFiOutlineBrush}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="Support independent development" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Achievement Relay is free. If it makes sharing your wins easier, you can support future development on Ko-fi." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="☕  Support on Ko-fi" Style="{StaticResource KoFiButton}" Click="OpenKoFi_Click" VerticalAlignment="Center" />
              </Grid>
