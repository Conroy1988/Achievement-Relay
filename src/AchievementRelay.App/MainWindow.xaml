<Window x:Class="AchievementRelay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Relay"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0C121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="6,8,0,28">
          <Image Source="Assets/AchievementRelay.png" Width="42" Height="42" Stretch="Uniform" />
          <StackPanel Margin="10,1,0,0">
            <TextBlock Text="ACHIEVEMENT" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="RELAY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18" />
            <TextBlock Text="XBOX  //  DISCORD" Foreground="{StaticResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button Style="{StaticResource NavButton}" Click="ShowDashboard_Click" Content="⌂   Dashboard" />
          <Button Style="{StaticResource NavButton}" Click="ShowSetup_Click" Content="✓   Guided setup" />
          <Button Style="{StaticResource NavButton}" Click="ShowActivity_Click" Content="↯   Activity" />
          <Button Style="{StaticResource NavButton}" Click="ShowSettings_Click" Content="⚙   Settings" />
          <Button Style="{StaticResource NavButton}" Click="ShowDiagnostics_Click" Content="◉   Diagnostics" />
          <Button Style="{StaticResource NavButton}" Click="ShowAbout_Click" Content="ⓘ   About" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="MONITOR STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
            <TextBlock x:Name="SidebarMonitorStatus" Text="Checking…" Margin="0,4,0,0" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </TabControl.Resources>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,36">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="New Xbox achievements are checked through your account and relayed to Discord automatically." />

            <Border Background="#D90B111A" BorderBrush="#315C477F" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RELAY ROUTE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="XBOX ACCOUNT" FontWeight="SemiBold" FontSize="11" />
                  <TextBlock Text="  ➜  " Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="SYNC NODE" FontWeight="SemiBold" FontSize="11" />
                  <TextBlock Text="  ➜  " Foreground="{StaticResource DiscordBrush}" />
                  <TextBlock Text="DISCORD CHANNEL" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="POLL // 60 SEC" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="XBOX ACCOUNT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="XboxStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock x:Name="XboxStatusDetail" Text="OpenXBL connection" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="DISCORD" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="DiscordStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock x:Name="DiscordStatusDetail" Text="Webhook destination" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="RELAY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="RelayStatusText" Text="Checking…" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" />
                  <TextBlock Text="One-minute account sync" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Quick actions" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="Check Xbox now, test Discord or review the guided setup." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Guided setup" Click="ShowSetup_Click" Margin="0,0,8,0" />
                  <Button Content="Send test" Click="SendSampleAchievement_Click" Margin="0,0,8,0" />
                  <Button Content="Sync now" Style="{StaticResource PrimaryButton}" Click="SyncNow_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10" />
            <ListBox x:Name="DashboardActivityList" Background="Transparent" BorderThickness="0" MaxHeight="270">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,50">
            <TextBlock Style="{StaticResource PageTitle}" Text="Guided setup" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Complete these three steps once. Existing achievements are baselined and will never flood your Discord." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDarkBrush}" VerticalAlignment="Top">
                  <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="Connect your Xbox account through OpenXBL" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="OpenXBL is an unofficial Xbox API provider. Create a personal key, paste it below, and Achievement Relay will verify the account and securely encrypt the key for this Windows user." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SetupXboxApiKeyPasswordBox" PasswordChar="●" ToolTip="OpenXBL API key" />
                    <Button Grid.Column="1" Content="Get free API key" Click="OpenOpenXbl_Click" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Save and connect" Style="{StaticResource PrimaryButton}" Click="SaveAndTestOpenXbl_Click" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock x:Name="SetupXboxStatus" Text="Status: not connected" Margin="0,10,0,0" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DiscordBrush}" VerticalAlignment="Top">
                  <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="Connect a Discord channel" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12">
                    <Run Text="In Discord: " FontWeight="SemiBold" />
                    <Run Text="Server Settings → Integrations → Webhooks → New Webhook → choose a channel → Copy Webhook URL." />
                  </TextBlock>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SetupWebhookPasswordBox" PasswordChar="●" ToolTip="Discord webhook URL" />
                    <Button Grid.Column="1" Content="Official guide" Click="OpenDiscordWebhookGuide_Click" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Save and test" Style="{StaticResource DiscordButton}" Click="SaveAndTestWebhook_Click" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock x:Name="SetupWebhookStatus" Text="Status: not connected" Margin="0,10,0,0" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDarkBrush}" VerticalAlignment="Top">
                  <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="Choose your preferences and finish" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="The connected gamertag is used automatically unless you enter another display name. Achievement Relay can also configure Windows startup." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                  <TextBlock Text="Player name shown in Discord" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                  <TextBox x:Name="SetupDisplayNameTextBox" MaxLength="80" Width="360" HorizontalAlignment="Left" />
                  <CheckBox x:Name="SetupStartWithWindowsCheckBox" Content="Start Achievement Relay automatically with Windows" IsChecked="True" />
                  <CheckBox x:Name="SetupStartMinimizedCheckBox" Content="Start quietly in the notification area" IsChecked="True" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Send sample achievement" Click="SendSampleAchievement_Click" Margin="0,0,10,0" />
              <Button Content="Finish setup" Style="{StaticResource PrimaryButton}" Click="FinishSetup_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <Grid Margin="34,30,34,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Local operational history. API keys and webhook URLs are never written here." />
          </StackPanel>
          <ListBox x:Name="ActivityList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Manage the Xbox account, Discord destination and Windows behaviour." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Xbox account · OpenXBL" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsXboxStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                <TextBlock Text="Paste a new key only when replacing the connected account" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <PasswordBox x:Name="SettingsXboxApiKeyPasswordBox" PasswordChar="●" />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Get API key" Click="OpenOpenXbl_Click" Margin="0,0,8,0" />
                  <Button Content="Retry / replace" Click="SaveAndTestSettingsOpenXbl_Click" Margin="0,0,8,0" />
                  <Button Content="Disconnect Xbox account" Click="RemoveOpenXbl_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Discord destination" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsWebhookStatus" Text="Not configured" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                <TextBlock Text="Paste a new webhook only when replacing the current destination" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <PasswordBox x:Name="SettingsWebhookPasswordBox" PasswordChar="●" />
                <Button Content="Remove saved webhook" Click="RemoveWebhook_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock Text="Webhook display name" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                <TextBox x:Name="SettingsDiscordUsernameTextBox" MaxLength="80" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Achievement posts" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Player name shown in Discord" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                <TextBox x:Name="SettingsDisplayNameTextBox" MaxLength="80" />
                <CheckBox x:Name="SettingsRareOnlyCheckBox" Content="Only post achievements marked rare by Xbox" />
                <CheckBox x:Name="SettingsRawDetailsCheckBox" Content="Include the unlocked achievement description" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Windows behaviour" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="SettingsStartWithWindowsCheckBox" Content="Start automatically with Windows" />
                <CheckBox x:Name="SettingsStartMinimizedCheckBox" Content="Start in the notification area" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Test Discord" Click="TestSettingsWebhook_Click" Margin="0,0,10,0" />
              <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="Diagnostics" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Check the complete Xbox → Achievement Relay → Discord path without waiting for another unlock." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Live status" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DiagnosticsStatusText" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Connection checks" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Sync now asks OpenXBL for the latest account achievements. Send sample tests only the Discord webhook." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14" />
                <WrapPanel>
                  <Button Content="Sync Xbox now" Style="{StaticResource PrimaryButton}" Click="SyncNow_Click" Margin="0,0,8,8" />
                  <Button Content="Send sample achievement" Click="SendSampleAchievement_Click" Margin="0,0,8,8" />
                  <Button Content="Open OpenXBL" Click="OpenOpenXbl_Click" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Support tools" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="The copied summary never contains the OpenXBL API key, Xbox user ID or Discord webhook token." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14" />
                <WrapPanel>
                  <Button Content="Open local data folder" Click="OpenDataFolder_Click" Margin="0,0,8,8" />
                  <Button Content="Copy support summary" Click="CopySupportSummary_Click" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,30,34,44">
            <TextBlock Style="{StaticResource PageTitle}" Text="About Achievement Relay" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Every achievement. Reliably shared." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Image Source="Assets/AchievementRelay.png" Width="96" Height="96" HorizontalAlignment="Left" />
                <TextBlock Text="Achievement Relay" FontSize="25" FontWeight="Bold" Margin="0,14,0,3" />
                <TextBlock x:Name="AboutVersionText" Text="Version 0.2.0 beta" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                <TextBlock Text="A Windows companion that checks an Xbox account for new achievements and sends rich unlock posts to a Discord channel chosen by the user." Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" MaxWidth="680" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource KoFiBrush}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                  <TextBlock Text="Help Achievement Relay grow" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="If the app makes sharing your unlocks easier, you can support future development on Ko-fi." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="☕  Support on Ko-fi" Style="{StaticResource KoFiButton}" Click="OpenKoFi_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Privacy and provider transparency" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Achievement Relay stores the OpenXBL API key and Discord webhook with Windows account encryption. The key is sent only to OpenXBL; achievement details are sent only to the configured Discord webhook. OpenXBL is an independent, unofficial Xbox API provider." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,14" />
                <WrapPanel>
                  <Button Content="View privacy policy" Click="OpenPrivacyPolicy_Click" Margin="0,0,8,0" />
                  <Button Content="Open GitHub" Click="OpenGitHub_Click" Margin="0,0,8,0" />
                  <Button Content="Open OpenXBL" Click="OpenOpenXbl_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
